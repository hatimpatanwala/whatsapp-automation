{
  "name": "wacommerce-desktop",
  "version": "0.1.3",
  "description": "WhatsApp-Commerce ERP â€” Windows desktop shell (Electron)",
  "author": "BeatRoute",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "cross-env DESKTOP_DEV_URL=http://localhost:4200 npm run start",
    "start:cloud": "cross-env DESKTOP_SHELL_ONLY=1 npm run start",
    "start:docker": "cross-env DESKTOP_DB=docker npm run start",
    "import:dump": "node scripts/import-dump.mjs",
    "dist": "npm run prepack:backend && npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "prepack:backend": "npm --prefix .. run build && npm --prefix ../frontend run build",
    "pack:full": "npm run prepack:backend && npm run dist"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "embedded-postgres": "17.10.0-beta.17"
  }
}
