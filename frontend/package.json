{
  "name": "wa-commerce",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:mobile": "ng build --configuration mobile",
    "build:mobile-erp": "ng build --configuration mobile-erp",
    "mobile:full:sync": "npm run build:mobile && cross-env WA_VARIANT=full cap sync",
    "mobile:full:android": "npm run build:mobile && cross-env WA_VARIANT=full cap run android",
    "mobile:full:open:android": "cross-env WA_VARIANT=full cap open android",
    "mobile:full:open:ios": "cross-env WA_VARIANT=full cap open ios",
    "mobile:erp:sync": "npm run build:mobile-erp && cross-env WA_VARIANT=erp cap sync",
    "mobile:erp:open:android": "cross-env WA_VARIANT=erp cap open android",
    "mobile:erp:open:ios": "cross-env WA_VARIANT=erp cap open ios"
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@capacitor/android": "^7.6.7",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@capacitor/ios": "^7.6.7",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@primeng/themes": "^21.0.4",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/vite": "^4.2.4",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.2"
  }
}
